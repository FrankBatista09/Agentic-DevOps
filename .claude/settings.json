{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": false,
  "permissions": {
    "allow": [
      "Edit(.chat-history/**)",
      "Write(.chat-history/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform init:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform show:*)",
      "Bash(terraform output:*)",
      "Bash(tflint:*)",
      "Bash(trivy:*)",
      "Bash(checkov:*)",
      "Bash(gitleaks:*)",
      "Bash(actionlint:*)",
      "Bash(hadolint:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(az account show:*)"
    ],
    "ask": [
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(az * create:*)",
      "Bash(az * delete:*)",
      "Bash(az * update:*)",
      "Bash(az * set:*)",
      "Bash(az role assignment:*)",
      "Bash(gh variable set:*)",
      "Bash(gh secret set:*)",
      "Bash(docker push:*)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git add:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)"
    ]
  }
}
